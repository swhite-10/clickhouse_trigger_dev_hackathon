# Langfuse appliance secrets — resolved by the 1Password CLI at start:
#   op run --env-file=infra/langfuse/.env.template -- docker compose ...
# (make langfuse-up does this for you)
#
# Every value here is GENERATED, not externally issued: `make
# secrets-bootstrap` mints the whole `langfuse` item, and the headless-init
# block below creates the org/project/user with those exact keys on first
# boot — no signup step, and trigger.config.ts exports traces with the same
# keys via op://gh-pulse/langfuse in infra/env/.env.template.

# --- appliance internals (compose interpolates these into service env) ---
SALT=op://gh-pulse/langfuse/salt
ENCRYPTION_KEY=op://gh-pulse/langfuse/encryption-key
NEXTAUTH_SECRET=op://gh-pulse/langfuse/nextauth-secret
POSTGRES_PASSWORD=op://gh-pulse/langfuse/postgres-password
CLICKHOUSE_PASSWORD=op://gh-pulse/langfuse/clickhouse-password
REDIS_AUTH=op://gh-pulse/langfuse/redis-password
MINIO_ROOT_PASSWORD=op://gh-pulse/langfuse/minio-password

# --- headless init (idempotent: only applied to an empty database) ---
LANGFUSE_INIT_ORG_ID=gh-pulse
LANGFUSE_INIT_ORG_NAME=gh-pulse
LANGFUSE_INIT_PROJECT_ID=gh-pulse
LANGFUSE_INIT_PROJECT_NAME=gh-pulse
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=op://gh-pulse/langfuse/public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=op://gh-pulse/langfuse/secret-key
# Login for the UI at http://localhost:3005 — the email is a neutral local
# address Langfuse only uses as the username, but the whole identity lives
# in the vault like everything else. NOTE: init only applies to an empty
# database, so changing these after first boot won't move the login —
# wipe the appliance volumes (docker compose down -v) to re-init.
LANGFUSE_INIT_USER_EMAIL=op://gh-pulse/langfuse/user-email
LANGFUSE_INIT_USER_NAME=op://gh-pulse/langfuse/user-name
LANGFUSE_INIT_USER_PASSWORD=op://gh-pulse/langfuse/user-password
