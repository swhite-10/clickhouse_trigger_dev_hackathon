# Secret references resolved by the 1Password CLI at runtime:
#   op run --env-file=infra/env/.env.template -- <command>
# (the Makefile does this for you: make dev, make trigger-dev)
#
# No secrets live on disk and no account-specific identifiers are committed —
# even non-secret ones like the Trigger.dev project ref live in the vault.
# One-time setup: make secrets-bootstrap   (idempotent, never overwrites)
# Verify anytime: make secrets-check       (read-only)

# --- Trigger.dev (cloud) ---
# Issued in the dashboard (project settings / API keys), not generated.
# The bootstrap creates placeholder fields — paste the real values with:
#   op item edit trigger --vault gh-pulse \
#     'secret-key[password]=tr_dev_...' 'project-ref[text]=proj_...'
TRIGGER_PROJECT_REF=op://gh-pulse/trigger/project-ref
TRIGGER_SECRET_KEY=op://gh-pulse/trigger/secret-key
TRIGGER_API_URL=https://api.trigger.dev

# --- Anthropic (agent model) ---
# Also set this in the Trigger.dev dashboard env vars for deployed runs;
# `trigger dev` picks it up locally from here.
ANTHROPIC_API_KEY=op://gh-pulse/anthropic/api-key

# --- ClickHouse ---
# On ClickHouse Cloud since the day-4 seed: gh_pulse_ro (readonly role,
# see infra/ch/cloud-setup.sh) against github_events (curated repos =
# full history, everyone else = last 90 days — see SYSTEM_PROMPT).
CLICKHOUSE_URL=op://gh-pulse/clickhouse/url
CLICKHOUSE_USER=op://gh-pulse/clickhouse/username
CLICKHOUSE_PASSWORD=op://gh-pulse/clickhouse/password

# --- ClickHouse Cloud admin (seed/DDL only — the app never uses these) ---
# From the Cloud console: service connection details, `default` user.
#   op item edit clickhouse-admin --vault gh-pulse \
#     'url[text]=https://<host>:8443' 'username[text]=default' \
#     'password[password]=<from console>'
CLICKHOUSE_ADMIN_URL=op://gh-pulse/clickhouse-admin/url
CLICKHOUSE_ADMIN_USER=op://gh-pulse/clickhouse-admin/username
CLICKHOUSE_ADMIN_PASSWORD=op://gh-pulse/clickhouse-admin/password
# Generated (not console-issued): the password ch-setup.sh assigns to the
# gh_pulse_ro user it creates. Copied into the clickhouse item's password
# field at actual cutover — kept separate until then so setup can run
# without touching the app's live credential.
CLICKHOUSE_RO_PASSWORD=op://gh-pulse/clickhouse-admin/ro-password

# --- ClickHouse Cloud API (clickhousectl cloud: service + Postgres mgmt) ---
# Console -> API keys -> new key with Admin role.
#   op item edit clickhouse-cloud-api --vault gh-pulse \
#     'key[text]=...' 'secret[password]=...'
CLICKHOUSE_CLOUD_API_KEY=op://gh-pulse/clickhouse-cloud-api/key
CLICKHOUSE_CLOUD_API_SECRET=op://gh-pulse/clickhouse-cloud-api/secret

# --- Langfuse (agent observability — itself powered by ClickHouse) ---
# Self-hosted appliance: make langfuse-up, UI at http://localhost:3005
# (login + keys minted by secrets-bootstrap, applied via headless init).
# trigger.config.ts exports the worker's OTel trace to it. Fail-open like
# capture: with the keys unset no exporter is registered — which is also
# why deployed cloud workers (no keys, no route to localhost) are unaffected.
LANGFUSE_HOST=http://localhost:3005
LANGFUSE_PUBLIC_KEY=op://gh-pulse/langfuse/public-key
LANGFUSE_SECRET_KEY=op://gh-pulse/langfuse/secret-key

# --- Postgres (OLTP: chat capture) ---
# Capture is fail-open: with DATABASE_URL unset the agent skips it entirely.
# On ClickHouse Cloud Postgres (gh-pulse-oltp, pg18) since day 4 — schema
# applied via `make pg-schema-cloud`. Local Docker alternative still works
# (clickhousectl local postgres start + make pg-schema) if you ever need to
# point this at a local instance instead — just repoint the item's url.
DATABASE_URL=op://gh-pulse/postgres/url
