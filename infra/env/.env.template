# Secret references resolved by the 1Password CLI at runtime:
#   op run --env-file=infra/env/.env.template -- <command>
# (the Makefile does this for you: make dev, make trigger-dev)
#
# No secrets live on disk and no account-specific identifiers are committed —
# even non-secret ones like the Trigger.dev project ref live in the vault.
# One-time setup: make secrets-bootstrap   (idempotent, never overwrites)
# Verify anytime: make secrets-check       (read-only)

# --- Trigger.dev (cloud) ---
# Issued in the dashboard (project settings / API keys), not generated.
# The bootstrap creates placeholder fields — paste the real values with:
#   op item edit trigger --vault gh-pulse \
#     'secret-key[password]=tr_dev_...' 'project-ref[text]=proj_...'
TRIGGER_PROJECT_REF=op://gh-pulse/trigger/project-ref
TRIGGER_SECRET_KEY=op://gh-pulse/trigger/secret-key
TRIGGER_API_URL=https://api.trigger.dev

# --- Anthropic (agent model) ---
# Also set this in the Trigger.dev dashboard env vars for deployed runs;
# `trigger dev` picks it up locally from here.
ANTHROPIC_API_KEY=op://gh-pulse/anthropic/api-key

# --- ClickHouse ---
# Bootstrap seeds url/username with the public playground so everything works
# before Cloud data lands. Playground's password is empty, which op can't
# store — so the password line stays literal until the Cloud switch.
# Moving to ClickHouse Cloud:
#   op item edit clickhouse --vault gh-pulse 'url[text]=https://<host>:8443' \
#     'username[text]=default' 'password[password]=<from console>'
# then swap the CLICKHOUSE_PASSWORD line below for the op:// reference.
CLICKHOUSE_URL=op://gh-pulse/clickhouse/url
CLICKHOUSE_USER=op://gh-pulse/clickhouse/username
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_PASSWORD=op://gh-pulse/clickhouse/password
